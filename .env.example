# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Optional: API Keys for Research
GOOGLE_SCHOLAR_API_KEY=
ARXIV_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Google OAuth (multi-user authentication)
# Client ID из Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# В "Authorized JavaScript origins" добавьте origin приложения (например https://ваш-домен).
GOOGLE_CLIENT_ID=

# Секрет для подписи Flask-сессии. Обязательно задайте в production
# (случайную длинную строку), иначе сессии не переживут редеплой и небезопасны.
SESSION_SECRET=

# PostgreSQL connection string (Relaxdev provides this when you add a database).
# Hypotheses are stored ONLY in PostgreSQL. Without it, data lives in memory
# and is not persisted between restarts.
# Example: postgresql://user:password@host:5432/dbname
# RelaxDev uses no TLS: do NOT add sslmode=require / ssl=true / channel_binding.
DATABASE_URL=

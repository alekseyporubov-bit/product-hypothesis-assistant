# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Optional: API Keys for Research
GOOGLE_SCHOLAR_API_KEY=
ARXIV_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# PostgreSQL connection string (Relaxdev provides this when you add a database).
# When set, hypotheses are stored in PostgreSQL instead of the JSON file.
# Example: postgresql://user:password@host:5432/dbname
# RelaxDev uses no TLS: do NOT add sslmode=require / ssl=true / channel_binding.
DATABASE_URL=
